##########################
### Descargar archivos ###
##########################
# Se hizo en bash usando sra toolkit

###############################################
### Filtrado de calidad y union de lecturas ###
###############################################

library(dada2)
library(phyloseq)
library(vegan)
install.packages("caret")
library(caret)

ruta <- "Datos"

R1 <- sort(list.files(ruta, pattern = "PRJNA494618_1.fastq", full.names = T))
R2 <- sort(list.files(ruta, pattern = "PRJNA494618_2.fastq", full.names = T))

filR1 <- file.path(ruta, "Filtrados", basename(R1))
filR2 <- file.path(ruta, "Filtrados", basename(R2))

salida <- filterAndTrim(R1, filR1, R2, filR2,
                        truncLen = 0,
                        maxN = 0, maxEE = c(2,2), truncQ=2, rm.phix = T,
                        compress=T, multithread = T)
head(salida)

errorR1 <- learnErrors(filR1, multithread = T)
errorR2 <- learnErrors(filR2, multithread = T)

dadaR1 <- dada(filR1, err = errorR1, multithread = T)
dadaR2 <- dada(filR2, err = errorR2, multithread = T)

combi <- mergePairs(dadaR1, filR1, dadaR2, filR2, verbose=T)
head(combi)

tabla_secuencias <- makeSequenceTable(combi)

taxa <- assignTaxonomy(tabla_secuencias, "Datos/silva_nr99_v138.2_toGenus_trainset.fa.gz", multithread = T)

ps <- phyloseq(
  otu_table(tabla_secuencias, taxa_are_rows = FALSE),
  tax_table(taxa)
)

#### Diversidad alfa

alpha <- estimate_richness(ps,measures = c("Observed","Chao1", "Shannon", "Simpson", "Invsimpson"))

diver <- ggplot(alpha, aes(x = "", y = Shannon)) + 
  geom_boxplot(col= "darkblue", fill = "skyblue") +
labs(title ="Diversidad alfa (shannon)", x = "", y = "Indice Shannon")
ggsave(plot = diver, "Resultados/diversidad_alpha.jpg"

###Diversidad beta (bray curtis)

ot <- otu_table(ps)
ot <- as(ot, "matrix")
bray_dist  <- vegdist (ot, method = "bray")

beta <- plot(bray_dist)

ggsave("Resultados/Diversidad_beta.jpg", plot = beta)










##### Permanova

labs(title = "PCoA basado en Bray-Curtis", x= "PCoA 1", y= "PCoA 2")

metadata <- read.csv("Datos/SraRunTable.csv")
head(metadata)

metadata$Colonia <- metadata$isolation_score
metadata$Fecha <- metadata$Collection_Date
metadata$Individuo <- metadata$Sample.Name

metadata$Run

rownames(metadata) <- metadata$Run

head(metadata)


sample_data(ps) <- sample_data(metadata)

adonis2(bray_dist~Tipo_Sitio + Colonia + Fecha,
        data= metadata,
        permutations = 100)



